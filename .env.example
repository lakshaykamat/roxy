TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
OPENAI_API_KEY=your_openai_api_key_here
# Optional: OpenAI model used to transcribe Telegram voice notes.
# OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
ALLOWED_USER_ID=123456789
TASK_TIMEZONE=Asia/Kolkata
EXPENSE_TRACKER_API_KEY=your_api_key_here
EXPENSE_TRACKER_BASE_URL=https://busty-expense-tracker-api.vercel.app
DEFAULT_CURRENCY=INR
# Optional: set automatically by Docker Compose to persist the database.
# DATABASE_PATH=/app/data/roxy.db
HISTORY_RETENTION_DAYS=90
MEMORY_RETENTION_DAYS=0
# Required for the authenticated dashboard at port 8888.
DASHBOARD_PASSWORD=choose_a_long_unique_password
DASHBOARD_SESSION_SECRET=generate_a_long_random_secret
# Set true only when HTTPS terminates before Roxy.
DASHBOARD_SECURE_COOKIES=false
